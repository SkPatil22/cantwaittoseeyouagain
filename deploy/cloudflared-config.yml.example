# Cloudflare Tunnel config for cantwaittoseeyouagain.com.
#
# After `cloudflared tunnel create cantwait` you'll get a tunnel UUID and a
# credentials JSON file. Fill them in below, then save this file as:
#
#   /etc/cloudflared/config.yml         (when running as the cloudflared svc)
#   ~/.cloudflared/config.yml           (when running under your own user)

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

# Optional: send an X-Forwarded-For-style header so the Python server can log
# the real visitor IP (CF-Connecting-IP is added automatically by Cloudflare).
originRequest:
  noTLSVerify: true
  connectTimeout: 10s

ingress:
  - hostname: cantwaittoseeyouagain.com
    service: http://localhost:8000
  - hostname: www.cantwaittoseeyouagain.com
    service: http://localhost:8000
  # Catch-all: any unmatched host returns 404 from the tunnel itself.
  - service: http_status:404
