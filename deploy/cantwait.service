# OPTIONAL - only if you want to host on your own always-on machine (e.g. a Raspberry Pi)
# instead of a free host. See "Hosting it yourself" in DEPLOY.md.
#
# Install:
#   sudo cp deploy/cantwait.service /etc/systemd/system/cantwait.service
#   # edit User= and the paths if your username / clone path differ
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cantwait
#   journalctl -u cantwait -f          # live logs

[Unit]
Description=cantwaittoseeyouagain (static site + visit log)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/cantwaittoseeyouagain
# Serves ONLY the site/ folder, with HTTP Range support (needed for video on iPhones).
# Use --host 127.0.0.1 if a tunnel/proxy on the same machine fronts it.
ExecStart=/usr/bin/python3 /home/pi/cantwaittoseeyouagain/server.py --host 0.0.0.0 --port 8000 --cache
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/cantwaittoseeyouagain/data

[Install]
WantedBy=multi-user.target
