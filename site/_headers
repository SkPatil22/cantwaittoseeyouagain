# Read by Cloudflare Pages (drag-and-drop or git) and Netlify - same format.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# Fonts never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Clips and pictures: a day. (The playlist below is always re-checked, so a rebuild shows up quickly.)
/clips/*
  Cache-Control: public, max-age=86400

/clips/media.json
  Cache-Control: no-cache
